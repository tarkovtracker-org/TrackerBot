# Discord bot
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# GitHub issue routing (webserver): both data and website reports use REPO_DEV.
# The production token must have issue-write access to this public repository.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
REPO_DEV=tarkovtracker-org/TarkovTracker
# Legacy REPO_DATA_REPORT settings are ignored while the overlay is private.

# Web server
PORT=3000
# Comma-separated list of allowed origins for the report forms.
# Leave blank to disable origin checking (not recommended for production).
ALLOWED_ORIGINS=https://tarkovtracker.org,https://www.tarkovtracker.org,https://trackerbot.nivmizz7.dev,https://www.trackerbot.nivmizz7.dev

# Discord channel IDs for automated posts
WELCOME_CHANNEL_ID=WELCOME_CHANNEL_ID

# Optional: comma-separated support role IDs, stable across renames.
# Ticket overwrites add View Channel, Send Messages and Read Message History only.
# Existing role permissions still apply; Administrator bypasses channel overwrites.
# Unset/blank preserves the legacy Discord Admin role and its existing overwrite.
# TICKET_STAFF_ROLE_IDS=SUPPORT_ROLE_ID

# Optional: category ID for newly created private tickets (not the ticket button channel).
# Recommended: set this so category renames do not affect routing.
# Unset/blank falls back to the existing "🆘 --- Support ---" category.
# TICKET_CATEGORY_ID=YOUR_SUPPORT_CATEGORY_ID

# Optional help desk (all values required together once any SUPPORT_* value is set).
# Product destinations are existing server text channels. No channels/roles are created by setup.
# SUPPORT_TRACKER_CHANNEL_ID=TRACKER_HELP_CHANNEL_ID
# SUPPORT_SCANNER_CHANNEL_ID=RATSCANNER_HELP_CHANNEL_ID
# SUPPORT_MONITOR_CHANNEL_ID=MONITOR_HELP_CHANNEL_ID
# Separate private-ticket categories and non-overlapping, non-managed staff role lists.
# SUPPORT_ACCOUNT_CATEGORY_ID=ACCOUNT_TICKETS_CATEGORY_ID
# SUPPORT_ACCOUNT_STAFF_ROLE_IDS=ACCOUNT_SUPPORT_ROLE_ID
# SUPPORT_MODERATION_CATEGORY_ID=MODERATION_TICKETS_CATEGORY_ID
# SUPPORT_MODERATION_STAFF_ROLE_IDS=MODERATION_ROLE_ID
# Publicly displayed HTTPS links to approved private contacts (not public report forms).
# Choose an independent escalation contact for concerns involving ticket staff.
# SUPPORT_CONTACT_URL=https://discord.com/users/CONTACT_USER_ID
# SUPPORT_ESCALATION_URL=https://discord.com/users/INDEPENDENT_CONTACT_USER_ID
# See docs/SUPPORT.md for permissions, rollout, smoke tests, and rollback.

# Optional staff-review destination. Unset/blank uses the existing Archive category.
# ARCHIVE_CATEGORY_ID=YOUR_ARCHIVE_CATEGORY_ID

# Optional HTTPS link overrides for /tt. Defaults remain on the main website.
# TT_SITE_URL=https://tarkovtracker.org/
# TT_RESOURCES_URL=https://tarkovtracker.org/resources

# honeypot channel. Anyone who posts in this channel is banned on
# sight (falls back to kick if the ban fails). Leave unset to disable.
HONEYPOT_CHANNEL_ID=HONEYPOT_CHANNEL_ID

# Discord role IDs
# Role IDs that grant /message, /channel and /nuke. Comma-separated.
# Also grant these roles command access in Server Settings > Integrations.
ADMIN_ROLE_ID=ADMIN_ROLE_ID
# Optional: comma-separated role IDs allowed to use /tt url and /tt resources.
# Unset/blank allows any member who can post; /tt help remains available privately.
# This does not grant access to administrative commands.
# ALLOWED_COMMAND_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
AUTO_ROLE_ID_1=ID_EXAMPLE
AUTO_ROLE_ID_2=ID_EXAMPLE
AUTO_ROLE_ID_3=ID_EXAMPLE
AUTO_ROLE_ID_4=ID_EXAMPLE

# Optional stable notification-role IDs; unset/blank uses the legacy role name.
# Use dedicated non-managed roles below the bot, with only basic communication permissions.
# Admin/support roles and roles with moderation/unknown permissions are never self-service.
# REACTION_ROLE_SITE_ID=SITE_NOTIFICATION_ROLE_ID
# REACTION_ROLE_MONITOR_ID=MONITOR_NOTIFICATION_ROLE_ID
# REACTION_ROLE_POLLS_ID=POLLS_NOTIFICATION_ROLE_ID
# REACTION_ROLE_NEWS_ID=NEWS_NOTIFICATION_ROLE_ID
# REACTION_ROLE_NOTIFS_ID=NOTIFICATION_ROLE_ID
