# Discord bot
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
ADMIN_IDS=DISCORD_USER_ID_1,DISCORD_USER_ID_2

# GitHub issue routing (webserver)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
REPO_DEV=orga/repo
REPO_DATA_REPORT=orga/repo

# Web server
PORT=3000
# Comma-separated list of allowed origins for the report forms.
# Leave blank to disable origin checking (not recommended for production).
ALLOWED_ORIGINS=https://tarkovtracker.org,https://www.tarkovtracker.org

# Discord channel IDs for automated posts
BUG_REPORT_CHANNEL_ID=BUG_REPORT_CHANNEL_ID
TICKET_CHANNEL_ID=TICKET_CHANNEL_ID
WELCOME_CHANNEL_ID=WELCOME_CHANNEL_ID

# Discord role IDs
PANEL_ADMIN_ROLE_ID=PANEL_ADMIN_ROLE_ID
# Optional: comma-separated role IDs allowed to use member commands.
# Falls back to the built-in default role ID when unset.
# ALLOWED_COMMAND_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
AUTO_ROLE_ID_1=ID_EXAMPLE
AUTO_ROLE_ID_2=ID_EXAMPLE
AUTO_ROLE_ID_3=ID_EXAMPLE
AUTO_ROLE_ID_4=ID_EXAMPLE
